# Copy this file to maestro.env and fill in real values.
# maestro.env is gitignored and must NEVER be shared or zipped.
# Used by run-maestro.ps1 (passed to flows as ${USERNAME} etc.).

# Primary test user - this is the "CDD user 1" referenced by test-cases.md.
# Role: Community Distributor, on the environment the APK points at.
USERNAME=jul-cdd-qa-1
PASSWORD=eGov@123

# HF Referral test user (flow 09 only) - a DIFFERENT user from CDD user 1 above, with
# its own boundary hierarchy below (common/ensure-home-hfreferral.yaml, Amit's call
# 2026-09-09). Required for flow 09; every other flow uses USERNAME/PASSWORD above.
HFREFERRAL_USERNAME=
HFREFERRAL_PASSWORD=

# Warehouse Manager test user (flow 11 only) - STOCKREPORTS role-gates its facility
# filter on fn:hasRole('WAREHOUSE_MANAGER'), so this must be a user actually assigned
# that role server-side (common/ensure-home-warehouse-manager.yaml). Flow 10 (the CDD
# sub-case of the same test case) reuses USERNAME/PASSWORD above.
WAREHOUSE_MANAGER_USERNAME=
WAREHOUSE_MANAGER_PASSWORD=

# Boundary levels at login, top level first.
# *_LABEL = the level's display name shown on the dropdown (e.g. State, Lga, Ward)
# *_VALUE = the option to pick at that level. The flow types it into the
#   dropdown's search box and taps the matching option row. Exact or partial
#   option text; matched as a regex-contains, so avoid regex metachars like
#   ( ) [ ] { } |. Do NOT quote values. Pick the boundary where your seeded
#   test data lives - search only finds households registered there.
# Leave unused deeper levels EMPTY - do not delete the lines.
BOUNDARY_L1_LABEL=
BOUNDARY_L1_VALUE=
BOUNDARY_L2_LABEL=
BOUNDARY_L2_VALUE=
BOUNDARY_L3_LABEL=
BOUNDARY_L3_VALUE=
# *_FILTER (optional) = the SHORT fragment actually TYPED into the dropdown
# search box; the row is still tapped/asserted by the full *_VALUE. Keep it
# short and lowercase (filter is case-insensitive): device typing is lossy -
# long strings can lose a keystroke while the dropdown rebuilds, and a
# corrupted filter matches nothing. Unset filters default to the full value.
# BOUNDARY_L1_FILTER=
# BOUNDARY_L2_FILTER=

# HF Referral test user's boundary (flow 09 only, common/ensure-home-hfreferral.yaml) -
# same rules as above, but goes up to 5 levels since this user's hierarchy may run
# deeper than CDD user 1's. Leave unused deeper levels EMPTY - do not delete the lines.
HFREFERRAL_BOUNDARY_L1_LABEL=
HFREFERRAL_BOUNDARY_L1_VALUE=
HFREFERRAL_BOUNDARY_L2_LABEL=
HFREFERRAL_BOUNDARY_L2_VALUE=
HFREFERRAL_BOUNDARY_L3_LABEL=
HFREFERRAL_BOUNDARY_L3_VALUE=
HFREFERRAL_BOUNDARY_L4_LABEL=
HFREFERRAL_BOUNDARY_L4_VALUE=
HFREFERRAL_BOUNDARY_L5_LABEL=
HFREFERRAL_BOUNDARY_L5_VALUE=
# HFREFERRAL_BOUNDARY_L1_FILTER=
# HFREFERRAL_BOUNDARY_L2_FILTER=

# Warehouse Manager test user's boundary (flow 11 only,
# common/ensure-home-warehouse-manager.yaml) - same rules as above, up to 5 levels.
# Leave unused deeper levels EMPTY - do not delete the lines.
WAREHOUSE_MANAGER_BOUNDARY_L1_LABEL=
WAREHOUSE_MANAGER_BOUNDARY_L1_VALUE=
WAREHOUSE_MANAGER_BOUNDARY_L2_LABEL=
WAREHOUSE_MANAGER_BOUNDARY_L2_VALUE=
WAREHOUSE_MANAGER_BOUNDARY_L3_LABEL=
WAREHOUSE_MANAGER_BOUNDARY_L3_VALUE=
WAREHOUSE_MANAGER_BOUNDARY_L4_LABEL=
WAREHOUSE_MANAGER_BOUNDARY_L4_VALUE=
WAREHOUSE_MANAGER_BOUNDARY_L5_LABEL=
WAREHOUSE_MANAGER_BOUNDARY_L5_VALUE=
# WAREHOUSE_MANAGER_BOUNDARY_L1_FILTER=
# WAREHOUSE_MANAGER_BOUNDARY_L2_FILTER=

# --- Optional flow-text overrides (sensible defaults are built into
# run-maestro.ps1; set these ONLY if your campaign localizes them differently) ---
# HOME_REG=Registration & Delivery
# HOME_REFERRAL=HF Referral   <- the HF Referral home tile (flow 09); UNVERIFIED - the
#     built-in default is a guessed regex, no flow has confirmed this campaign's actual
#     text yet. Fill this in once you've seen it, or after the first run of flow 09.
# HOME_STOCK_RECON=Stock Reconciliation   <- the Stock Reconciliation home tile
#     (flows 12/13); UNVERIFIED for the same reason as HOME_REFERRAL above.
# PROJECT_NAME=(?i).*campaign.*   <- project card tapped on the post-login Projects screen
# DOWNLOAD_PROGRESS=Data is being downloaded   <- text on the boundary-data download
#     progress dialog; ensure-home waits for it to disappear (5 min) before the
#     home wait, so a slow sync fails as "download stuck" not "home not found"
# BTN_NEXT=Next
# BTN_RECORD=Record Data
# (OPT_YES / OPT_NO retired 2026-09-03: radio options are picked by their
#  config enum code now - consentToParticipate_TRUE, ec1_NO ... - because the
#  visible "Yes"/"No" labels are absorbed into the field's merged label node
#  and cannot be matched as text at all.)
# GENDER_HEAD=Male
# GENDER_CHILD=Female
# HEAD_AGE_YEARS=36     <- typed into the dob widget's age-Years field
# CHILD_AGE_MONTHS=44   <- age-Months field; must be 3-59 for SMC eligibility

# Notes for manual testing (fill in what exists on your environment):
# - The boundary above must be where the seeded/registered test data lives -
#   search only finds households registered in the logged-in boundary.
# - A household known to exist (for search cases): <head-of-household name>
# - Additional users (supervisor etc.) if a case needs them: keep them here as
#   comments, never in test-cases.md.
